# ── LLM Providers ──────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# OpenRouter is no longer required — all models run on Groq
# OPENROUTER_API_KEY=your_openrouter_api_key_here (optional, unused)

# Get your Groq key at: https://console.groq.com/keys

# ── Models (all Groq-hosted) ────────────────────────────────────────────────
PROPOSER_MODEL=openai/gpt-oss-120b
ADVERSARY_A_MODEL=openai/gpt-oss-120b
ADVERSARY_B_MODEL=openai/gpt-oss-120b
JUDGE_MODEL=openai/gpt-oss-120b
PERSPECTIVE_MODEL=openai/gpt-oss-120b
JUDGE_FALLBACK_MODEL=openai/gpt-oss-120b

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
USE_FAKEREDIS=true          # Set false in production with real Redis

# ── Semantic Cache ──────────────────────────────────────────────────────────
CACHE_COSINE_THRESHOLD=0.85         # Tier 1 similarity threshold
CACHE_CROSS_ENCODER_THRESHOLD=0.65  # Tier 2 cross-encoder gate
CACHE_LLM_VALIDATION=true           # Enable Tier 3 LLM validation
CACHE_TTL_SECONDS=3600              # 1 hour default TTL

# ── App ─────────────────────────────────────────────────────────────────────
# Backend URL — point to your HuggingFace Space URL:
NEXT_PUBLIC_API_URL=https://theshivansh-ACHP-api.hf.space
# Or use ACHP_API_URL for server-side only (not exposed to browser):
# ACHP_API_URL=https://theshivansh-ACHP-api.hf.space
ACHP_LOG_LEVEL=INFO
