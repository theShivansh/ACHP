{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
   "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(pnpm -C apps/web typecheck)",
      "Bash(pnpm -C apps/web lint)",
      "Bash(pnpm -C apps/web test:*)",
      "Bash(pnpm -C apps/web test)",
      "Bash(pnpm -C apps/web test:e2e:*)",
      "Bash(pnpm -C apps/web build)",
      "Bash(node scripts/ui/shoot.mjs:*)",
      "Bash(node .claude/hooks/anti-slop-check.mjs:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(rg:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./apps/api/.env)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/anti-slop-check.mjs", "timeout": 20 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-on-stop.sh", "timeout": 240 }
        ]
      }
    ]
  }
}
