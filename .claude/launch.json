{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "apps/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-desk",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "apps/web",
        "dev"
      ],
      "port": 3000,
      "env": {
        "NEXT_PUBLIC_API_URL": "https://theshivansh-achp-api.hf.space",
        "NODE_OPTIONS": "--use-system-ca"
      }
    },
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "main:app",
        "--app-dir",
        "apps/api",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
